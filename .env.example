# Cloudinary cloud name (defaults to the academy's cloud if omitted)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=dtb4hsasc

# Canonical site URL: used for canonical links, Open Graph, sitemap.xml and structured data
NEXT_PUBLIC_SITE_URL=https://sebastian.org

# Only needed for `npm run media:sync` (keep the secret in .env.local, never commit it)
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# The K-Arena booking API, which takes the academy's registration payments by
# M-Pesa (/register). Include /api/v1. The browser calls it directly, so this
# site's origin (e.g. https://sebastian.org) must be listed in that API's
# ALLOWED_ORIGINS. Without it the register page says online registration is
# unavailable. These are fixed into the page when it is built.
NEXT_PUBLIC_KARENA_API_URL=https://karena.stsebastiansportsacademy.com/api/v1
# Optional: the API's WebSocket origin if it is not the API's own host.
# NEXT_PUBLIC_KARENA_WS_URL=wss://karena.stsebastiansportsacademy.com
